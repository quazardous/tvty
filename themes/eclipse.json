{
  "$schema": "https://github.com/longbridge/gpui-kit/raw/refs/heads/main/.theme-schema.json",
  "name": "Eclipse",
  "author": "Lorenzo Billi",
  "url": "https://github.com/lorenzobilli/Eclipse-color-theme",
  "themes": [
    {
      "name": "Eclipse Dark",
      "mode": "dark",
      "colors": {
        "accent.background": "#3a3f45",
        "accent.foreground": "#D9E8F7",
        "background": "#292929",
        "border": "#3f3f3f",
        "window_border": "#4a4a4a",
        "ring": "#3EABE6",
        "foreground": "#D9E8F7",
        "input.border": "#4a4a4a",
        "link.active.foreground": "#79ABFF",
        "link.foreground": "#3EABE6",
        "link.hover.foreground": "#79ABFF",
        "list.active.background": "#3EABE633",
        "list.active.border": "#3EABE6",
        "list.hover.background": "#353535",
        "list.even.background": "#2d2d2d",
        "muted.background": "#3c3c3c66",
        "muted.foreground": "#8e959c",
        "panel.background": "#313131",
        "popover.background": "#2f2f2f",
        "popover.foreground": "#D9E8F7",
        "primary.active.background": "#1290C3",
        "primary.background": "#1290C3",
        "primary.foreground": "#ffffff",
        "primary.hover.background": "#1290C3ee",
        "danger.background": "#F44747",
        "danger.active.background": "#AB1F36",
        "danger.foreground": "#ffffff",
        "scrollbar.background": "#29292900",
        "scrollbar.thumb.background": "#4f4f4f",
        "scrollbar.thumb.hover.background": "#626262",
        "secondary.active.background": "#3c3c3c",
        "secondary.background": "#333333",
        "secondary.foreground": "#D9E8F7",
        "secondary.hover.background": "#383838",
        "selection.background": "#2F5B7C",
        "tab.active.background": "#292929",
        "tab.active.foreground": "#D9E8F7",
        "tab.background": "#31313100",
        "tab.foreground": "#8e959c",
        "tab_bar.background": "#313131",
        "title_bar.background": "#3c3c3c",
        "title_bar.border": "#2a2a2a",
        "status_bar.background": "#3c3c3c",
        "chart.grid": "#333333",
        "base.red": "#DD2867",
        "base.red.light": "#FF9393",
        "base.green": "#1EB540",
        "base.green.light": "#A7EC21",
        "base.yellow": "#FFBF26",
        "base.yellow.light": "#ED7F48",
        "base.blue": "#3EABE6",
        "base.blue.light": "#79ABFF",
        "base.magenta": "#CC81BA",
        "base.magenta.light": "#D7837F",
        "base.cyan": "#17C6A3",
        "base.cyan.light": "#66E1F8"
      },
      "highlight": {
        "editor.foreground": "#D9E8F7",
        "editor.background": "#292929",
        "editor.active_line.background": "#2f2f2f",
        "editor.line_number": "#626262",
        "editor.active_line_number": "#D9E8F7",
        "editor.invisible": "#62626266",
        "conflict": "#F44747",
        "created": "#1EB540",
        "deleted": "#DD2867",
        "error": "#F44747",
        "hidden": "#626262",
        "hint": "#79ABFF",
        "ignored": "#626262",
        "info": "#3EABE6",
        "modified": "#FFBF26",
        "predictive": "#626262",
        "renamed": "#FFBF26",
        "success": "#1EB540",
        "unreachable": "#626262",
        "warning": "#FFBF26",
        "syntax": {
          "attribute": { "color": "#FF9393" },
          "boolean": { "color": "#DD2867" },
          "comment": { "color": "#626262" },
          "comment.doc": { "color": "#626262" },
          "constant": { "color": "#8DDAF8" },
          "constructor": { "color": "#1290C3" },
          "function": { "color": "#A7EC21" },
          "keyword": { "color": "#DD2867" },
          "link_text": { "color": "#3EABE6", "font_style": "normal" },
          "link_uri": { "color": "#79ABFF", "font_style": "italic" },
          "number": { "color": "#6897BB" },
          "operator": { "color": "#E6E6FA" },
          "property": { "color": "#66E1F8" },
          "string": { "color": "#17C6A3" },
          "string.escape": { "color": "#17C6A3" },
          "string.regex": { "color": "#17C6A3" },
          "tag": { "color": "#0080FF" },
          "title": { "color": "#1290C3", "font_weight": 600 },
          "type": { "color": "#1290C3" },
          "variable": { "color": "#FFBF26" },
          "variable.special": { "color": "#ED7F48" }
        }
      }
    }
  ]
}
