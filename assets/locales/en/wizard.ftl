# A setting's wizard: aiball's questions and steps, in tvty's words.
wizard-title-config-dir = Switch the Claude Code config dir
wizard-q-confirm = Stop and restart {$loops} loop(s) ({$names}) on {$target}: their conversations follow.
wizard-q-confirm-none = Switch to {$target}: no loop runs in this folder.
wizard-q-fork = Bring how Claude works in {$current} to {$target}?
wizard-a-fork = Bring it, linked: CLAUDE.md, settings, skills, agents, commands, plugins; what is already there stays
wizard-q-move = Move this folder's conversations from {$from} to {$to}?
wizard-a-move-yes = Move them: the loops resume where they were
wizard-a-move-no = Leave them: the loops start new conversations
wizard-step-idle = Wait until the loops are idle
wizard-step-stop = Stop the loops
wizard-step-free = Wait until no Claude runs in the folder
wizard-step-write = Write the setting, move the conversations
wizard-step-start = Start the loops again
wizard-said-waiting-busy = waiting for {$names}, at work
wizard-said-loops-idle = the loops are idle
wizard-said-still-busy = still at work: {$names}
wizard-said-stopping = stopping {$names}
wizard-said-waiting-stop = waiting for {$names} to stop
wizard-said-stopped = stopped: {$names}
wizard-said-still-running = did not stop: {$names}
wizard-said-claude-in-folder = a Claude still runs in the folder ({$pids})
wizard-said-folder-free = no Claude in the folder
wizard-said-not-checked = the running processes cannot be listed here: not checked
wizard-said-claude-still = a Claude still runs in the folder ({$pids})
wizard-said-written = written: {$dir}
wizard-said-starting = starting {$names}
wizard-said-started = started: {$names}
wizard-said-not-started = not started: {$names}
wizard-said-cancelled = cancelled
wizard-fallback-plan = If it stops before the write, the loops start again on {$current}.
wizard-fallback-restarted = The loops started again on {$dir}: {$names}
wizard-fallback-not-restarted = Not started again: {$names}
wizard-status-running = Under way
wizard-status-done = Done
wizard-status-failed = Failed
wizard-status-cancelled = Cancelled
wizard-status-interrupted = Interrupted: aiball restarted during the run
wizard-loading = Asking aiball what it would do…
wizard-steps = What aiball will do
wizard-no-return = no going back from here
wizard-start = Start
wizard-cancel = Cancel
wizard-close = Close
wizard-stop = Stop the run
wizard-busy-mark = at work
wizard-running-tip = {$title}: under way
wizard-failed = {$title}
wizard-confirm = I confirm
wizard-now = Now: {$value}
wizard-next = Next
wizard-change = Change…
wizard-change-tip = Changed through a wizard: aiball says what it will do and asks first, then runs it
wizard-others = Dirs other folders use
wizard-type-path = a path, then Enter
wizard-a-keep = Keep {$target} as it is
wizard-step-ready = Check the new dir again
wizard-said-target-ready = {$dir} is ready
wizard-said-target-not-ready = the new dir is no longer ready: nothing written
wizard-not-ready = {$dir} has not been through Claude's first run (theme, login): a loop cannot start on it. Run claude on it once by hand first.
