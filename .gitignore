# ── Build ────────────────────────────────────────────────────────────
/target/
__pycache__/
*.pyc

# ── Test and demo runtime ────────────────────────────────────────────
# Everything under dev/ is made by the tests and the demo (a throwaway
# aiball, tmux servers, loop state, settings, logs, screenshots), except
# the fixtures kept below: a new runtime directory is ignored by itself.
/dev/*
!/dev/sim/
!/dev/tvty-wbox/
/dev/tvty-wbox/*
!/dev/tvty-wbox/config.yaml
!/dev/tvty-wbox/scripts/

# ── Local agent wiring ───────────────────────────────────────────────
# How this working copy is plugged into its tools — aiball (the agent's
# identity, its session), the MCP servers (aiball, wbox), Claude Code's
# settings: each machine's own, never the project's.
/.aiball.yaml
/.aiball-session_id
/.mcp.json
/.claude/

# ── Editors and systems ──────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~
.DS_Store
