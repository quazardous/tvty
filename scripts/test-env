# Sourced by everything that tests tvty: a test tvty lives apart from the
# user's own. It has
# - its own tmux server (TMUX_TMPDIR): the test sessions are not listed in
#   the user's tvty, and a test tvty cannot see — let alone attach — a real
#   agent's loop;
# - its own settings (XDG_CONFIG_HOME) and memory (XDG_STATE_HOME): the
#   user's settings.toml, keymap.toml, layout and workspace are never read
#   nor written;
# - the throwaway aiball (AIBALL_SOCK): never the user's board.
# TVTY_ROOT is the repository; set it before sourcing, or it is found here.
: "${TVTY_ROOT:=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)}"
# Nothing of the caller's own loop: a shell that runs inside an agent's loop
# carries its variables (its state directory, its session host's control
# socket, its agent), and a loop a test starts would take them for its own —
# typing into that agent's Claude, or sweeping its processes.
for var in $(env | sed -n 's/^\(CL_[A-Z_]*\|AIBALL_[A-Z_]*\|CLAUDE_LOOP_[A-Z_]*\|TMUX_PANE\)=.*/\1/p'); do
    unset "$var"
done
export TMUX_TMPDIR="$TVTY_ROOT/dev/tmux"
export XDG_CONFIG_HOME="$TVTY_ROOT/dev/tvty-wbox/config"
export XDG_STATE_HOME="$TVTY_ROOT/dev/tvty-wbox/state"
# its own fonts (XDG_DATA_HOME): the user's ~/.local/share/tvty/fonts is not read
export XDG_DATA_HOME="$TVTY_ROOT/dev/tvty-wbox/data"
export AIBALL_SOCK="$TVTY_ROOT/dev/fake-aiball/home/sock"
# Its home too, as the daemon sees it (scripts/fake-aiball's short link):
# claude-loop reads its session hosts there to tell a live loop.
export AIBALL_HOME="${XDG_RUNTIME_DIR:-/tmp}/tvty-fake-aiball-$(id -u)"
# Loops a test starts: their state apart, fake-claude instead of claude.
export CLAUDE_LOOP_STATE_ROOT="$TVTY_ROOT/dev/claude-loop"
export CL_CLAUDE_CMD="$(cd "$TVTY_ROOT/.." && pwd)/aiball/bin/fake-claude"
# The debug control (scripts/tvty-ctl): a test tvty is read and driven by id.
export TVTY_DEBUG_CONTROL=1
unset TMUX
mkdir -p "$TMUX_TMPDIR" "$XDG_CONFIG_HOME/tvty" "$XDG_STATE_HOME/tvty" "$CLAUDE_LOOP_STATE_ROOT"
# The projects' list starts folded: nothing to click by accident (unless an
# older tvty's state.json is still there to be migrated).
[ -f "$XDG_STATE_HOME/tvty/layout.json" ] || [ -f "$XDG_CONFIG_HOME/tvty/state.json" ] \
    || echo '{"sidebar_open": false}' >"$XDG_STATE_HOME/tvty/layout.json"
