#!/usr/bin/env bash
# check-public — tvty is a public repo: refuse what a stranger could not
# follow. Scans the files git tracks (or, with --staged, the staged ones)
# for dev-machine paths and internal tracker ids. Exit 1 on a hit.
#
#   scripts/check-public            every tracked file
#   scripts/check-public --staged   what is about to be committed (pre-commit)
#   scripts/check-public --history  every commit: its message and the lines it
#                                   added — what a clone shows with git log -p
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Dev-machine paths; a board's ticket (#1234) or comment (#C.abcd12) id.
pattern='((^|[[:space:]"'"'"'=:(`])(/home|/Users)/[A-Za-z]|[A-Z]:\\Users\\|(^|[^&A-Za-z0-9])#[0-9]{3,}\b|#C\.[a-z0-9]{4,8}\b)'
if [[ ${1:-} == --history ]]; then
    # Each commit's message, then each line it added, prefixed by the commit
    # (bundled themes and this script's own examples aside).
    hits=$(
        {
            git log --all --format='%h %s%n%h %b'
            git log --all -p --format='commit %h' -- . ':!themes/*.json' ':!scripts/check-public' |
                awk '/^commit [0-9a-f]+$/ { c = $2; next } /^\+[^+]/ { print c " " substr($0, 2) }'
        } | grep -E "^[0-9a-f]+ .*$pattern" || true
    )
    if [[ -n $hits ]]; then
        echo "Not for a public repo, in the history (a path of your machine, or an internal ticket id):" >&2
        echo "$hits" >&2
        exit 1
    fi
    exit 0
fi
if [[ ${1:-} == --staged ]]; then
    mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR)
else
    mapfile -t files < <(git ls-files)
fi
# Bundled theme sets are third-party data full of hex colours (#179299),
# which read like ticket ids.
mapfile -t files < <(printf '%s\n' "${files[@]}" | grep -v '^themes/.*\.json$')
((${#files[@]})) || exit 0
if hits=$(grep -nIE "$pattern" -- "${files[@]}" 2>/dev/null | grep -v '^scripts/check-public:'); then
    echo "Not for a public repo (a path of your machine, or an internal ticket id):" >&2
    echo "$hits" >&2
    exit 1
fi
