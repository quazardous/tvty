#!/usr/bin/env bash
# test-tvty — runs tvty apart from the user's own (see scripts/test-env):
# the test tmux server, the test settings, the throwaway aiball (started if
# it is not up; TVTY_NO_AIBALL=1: none, where aiball is not installed — a CI
# checking the window alone; TVTY_AIBALL=proxy: the node of the proxy
# stack, scripts/proxy-stack, as a tvty on a machine behind a node).
# Arguments go to tvty (a session to open).
set -euo pipefail
TVTY_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$TVTY_ROOT/scripts/test-env"
if [[ ${TVTY_AIBALL:-} == proxy ]]; then
    export AIBALL_SOCK="$TVTY_ROOT/dev/proxy-stack/run/node/sock/sock"
    [[ -S $AIBALL_SOCK ]] || { echo "the proxy stack is not up: scripts/proxy-stack up" >&2; exit 1; }
elif [[ -z ${TVTY_NO_AIBALL:-} ]]; then
    "$TVTY_ROOT/scripts/fake-aiball" up >/dev/null
fi
export TVTY_STATS="${TVTY_STATS-$TVTY_ROOT/dev/tvty-wbox/log/tvty-stats.log}"
# A steady cursor, unless the test settings say otherwise: a blinking one
# makes two shots of the same screen differ (and reads as a flicker).
SETTINGS="$XDG_CONFIG_HOME/tvty/settings.toml"
if ! grep -q '^cursor *=' "$SETTINGS" 2>/dev/null; then
    if grep -q '^\[terminal\]' "$SETTINGS" 2>/dev/null; then
        sed -i 's/^\[terminal\]$/[terminal]\ncursor = "steady"/' "$SETTINGS"
    else
        printf '\n[terminal]\ncursor = "steady"\n' >>"$SETTINGS"
    fi
fi
# Its errors (a panic, with its backtrace) and how it ended, kept: a
# window gone without a word says why here (scripts/desktop-check prints it).
STDERR_LOG="$TVTY_ROOT/dev/tvty-wbox/log/tvty-stderr.log"
mkdir -p "$(dirname "$STDERR_LOG")"
echo "$(date -Is) tvty starts" >>"$STDERR_LOG"
code=0
RUST_BACKTRACE="${RUST_BACKTRACE-1}" "$TVTY_ROOT/target/debug/tvty" "$@" 2> >(tee -a "$STDERR_LOG" >&2) || code=$?
echo "$(date -Is) tvty ended, code $code" >>"$STDERR_LOG"
exit $code
