#!/usr/bin/env bash
# fake-aiball — a throwaway aiball daemon with a demo project, for testing
# tvty's ticket panel without touching the real board.
#
#   scripts/fake-aiball up     start the daemon, seed it, start the demo loops
#   scripts/fake-aiball down   stop the loops and the daemon, drop its data: the
#                              sessions it hosts and the test loops go too
#   scripts/fake-aiball env    print what points tvty at it (its socket)
#
# Everything lives in dev/fake-aiball/: its own AIBALL_HOME, config dir, port
# (7797) and socket. The demo project `demo` has two agents, demo-claude and
# demo-crew, whose "loops" are tmux sessions cl-demo-lead / cl-demo-crew
# running fake-claude in dev/fake-aiball/demo/{lead,crew}. An agent started
# on the daemon's host (session.start) runs fake-claude too, never Claude.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Nothing of the caller's own loop reaches the daemon, nor the loops it
# starts (session.start, loop.restart): run from inside an agent's loop,
# its variables (state directory, session host's control socket) would be
# taken for theirs — as scripts/test-env clears them.
for var in $(env | sed -n 's/^\(CL_[A-Z_]*\|AIBALL_[A-Z_]*\|CLAUDE_LOOP_[A-Z_]*\|TMUX_PANE\)=.*/\1/p'); do
    unset "$var"
done
# The demo loops run on the test tmux server (scripts/test-env); the
# daemon keeps its own socket and config below.
TMUX_TMPDIR="$ROOT/dev/tmux"; export TMUX_TMPDIR; unset TMUX
mkdir -p "$TMUX_TMPDIR"
# TVTY_AIBALL_SRC: another aiball checkout (a patched copy, to try a fix).
AIBALL="${TVTY_AIBALL_SRC:-$(dirname "$ROOT")/aiball}"
DIR="$ROOT/dev/fake-aiball"
HOME_DIR="$DIR/home"
SOCK="$HOME_DIR/sock"
PIDFILE="$HOME_DIR/daemon.pid"
# A session host's socket path is capped (about 100 bytes) and the checkout
# may sit deep: the daemon sees its home through a short link.
SHORT_HOME="${XDG_RUNTIME_DIR:-/tmp}/tvty-fake-aiball-$(id -u)"
DEMO="$DIR/demo"

running() { [[ -f $PIDFILE ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

LOOPS="$ROOT/dev/claude-loop"

# This script and the shells that run it: their command lines may name the
# paths below, and they must not be taken for leftovers.
ancestors() {
    local pid=$$
    while [[ $pid -gt 1 ]]; do
        echo "$pid"
        pid=$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null) || break
    done
}

# What tests left running: the session hosts of this daemon (their --dir is
# under its home), the test loops (their state is under dev/claude-loop) and
# what runs in them. Found by command line or environment, by pid — never a
# kill by pattern, which could reach the user's own processes.
leftovers() {
    local keep pid
    keep=" $(ancestors | tr '\n' ' ') "
    for proc in /proc/[0-9]*; do
        pid=${proc#/proc/}
        [[ $keep == *" $pid "* ]] && continue
        if tr '\0' '\n' 2>/dev/null <"$proc/cmdline" | grep -qF -e "$HOME_DIR/hosts/" -e "$SHORT_HOME/hosts/" -e "$LOOPS/" ||
            tr '\0' '\n' 2>/dev/null <"$proc/environ" | grep -qx -e "CL_STATE_DIR=$LOOPS/.*"; then
            echo "$pid"
        fi
    done
}

# Stops the sessions the daemon hosts (while it answers), then whatever is
# left of the tests, then forgets the test loops.
clean() {
    if running; then
        AIBALL_SOCK="$SOCK" "$ROOT/scripts/aiball-call" session.list 2>/dev/null |
            python3 -c 'import json,sys
for s in json.load(sys.stdin):
    print(json.dumps({"agent": s["agent"]} if s.get("agent") else {"name": s["name"]}))' |
            while read -r which; do
                AIBALL_SOCK="$SOCK" "$ROOT/scripts/aiball-call" session.stop "$which" >/dev/null 2>&1 || true
            done
    fi
    local pids
    pids=$(leftovers)
    if [[ -n $pids ]]; then
        # shellcheck disable=SC2086
        kill $pids 2>/dev/null || true
        sleep 1
        pids=$(for pid in $pids; do kill -0 "$pid" 2>/dev/null && echo "$pid"; done)
        # shellcheck disable=SC2086
        [[ -z $pids ]] || kill -9 $pids 2>/dev/null || true
    fi
    rm -rf "${LOOPS:?}"/*
}

case "${1:-}" in
    up)
        if running; then echo "fake aiball already up"; exit 0; fi
        # What a daemon that fell left behind.
        clean
        rm -rf "$HOME_DIR"
        mkdir -p "$HOME_DIR" "$DIR/config" "$DEMO/lead" "$DEMO/crew"
        ln -sfn "$HOME_DIR" "$SHORT_HOME"
        # The test loops' state (scripts/test-env): the daemon relays loop
        # controls (hold, tmux line) to the loops it finds there.
        AIBALL_HOME="$SHORT_HOME" XDG_CONFIG_HOME="$DIR/config" AIBALL_PORT=7797 \
            AIBALL_HOST=127.0.0.1 AIBALL_SOCK="$SOCK" \
            CLAUDE_LOOP_STATE_ROOT="$ROOT/dev/claude-loop" \
            CL_CLAUDE_CMD="$AIBALL/bin/fake-claude" \
            nohup "$AIBALL/bin/aiball-daemon" >"$DIR/daemon.log" 2>&1 &
        for _ in $(seq 50); do [[ -S $SOCK ]] && break; sleep 0.2; done
        [[ -S $SOCK ]] || { echo "the daemon did not start, see $DIR/daemon.log" >&2; exit 1; }
        python3 "$ROOT/scripts/fake-aiball-seed.py" "$SOCK" "$DEMO"
        for sub in lead crew; do
            tmux has-session -t "=cl-demo-$sub" 2>/dev/null ||
                tmux new-session -d -s "cl-demo-$sub" -c "$DEMO/$sub" -x 160 -y 48 "$AIBALL/bin/fake-claude"
        done
        echo "fake aiball up — AIBALL_SOCK=$SOCK"
        ;;
    down)
        clean
        for sub in lead crew; do tmux kill-session -t "=cl-demo-$sub" 2>/dev/null || true; done
        if running; then kill "$(cat "$PIDFILE")"; fi
        rm -rf "$HOME_DIR"
        rm -f "$SHORT_HOME"
        echo "fake aiball down"
        ;;
    env)
        echo "AIBALL_SOCK=$SOCK"
        ;;
    *)
        sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
