#!/usr/bin/env python3
"""tvty-ctl — drives and reads a test tvty by name, not by pixels.

    scripts/tvty-ctl tree [PREFIX]      the elements on screen: id, x, y, w, h, text
    scripts/tvty-ctl tree --text [PREFIX]   those that say something: id, then its text
    scripts/tvty-ctl text ID            what ID says (a button's label, a row's title)
    scripts/tvty-ctl wait-text ID TEXT [MS]   until ID says TEXT (contains it)
    scripts/tvty-ctl where ID           the middle of ID on screen
    scripts/tvty-ctl click ID           a click on ID, put in through the window
    scripts/tvty-ctl dblclick ID        a double click on ID
    scripts/tvty-ctl … --text PREFIX TEXT   in place of an ID (click, dblclick, hover, press,
                                        where, wait): the one element under PREFIX that says
                                        TEXT — a ticket by its title, a menu's entry by its label
    scripts/tvty-ctl window maximize | restore | size W H
                                        the window maximized, put back, or given a size
    scripts/tvty-ctl hold MODS          modifiers held until `release` (ctrl, ctrl-shift…): what
                                        lives while a key is held (the slider) stays between
                                        two commands
    scripts/tvty-ctl release            the modifiers let go
    scripts/tvty-ctl hover ID           the pointer moved onto ID
    scripts/tvty-ctl press ID           a press on ID never released (let go outside the window)
    scripts/tvty-ctl selection          the text selected in the window, if any
    scripts/tvty-ctl key KEYS           a keystroke, as the keymap writes it (ctrl-enter)
    scripts/tvty-ctl type TEXT          TEXT typed
    scripts/tvty-ctl wait ID [MS]       until ID is on screen (5000 ms at most)
    scripts/tvty-ctl state              the page, the terminal, the panel, the bus, what is open in the views
    scripts/tvty-ctl ready [MS]         until the control answers, after a launch (20000 ms at most)
    scripts/tvty-ctl shot [--region ID[+ID…]] [--margin N] [--no-tips] [--now] [--out FILE] NAME
                                        a capture taken once the screen holds still (--now: at
                                        once, in mid-movement) and tvty has drawn: never an old
                                        frame; --region: only the box around those elements
                                        (--margin pixels more, 8 by default); --no-tips: the
                                        pointer put away first; --out: the picture copied there
    scripts/tvty-ctl settle [MS]        until the screen holds still: none of tvty's animations
                                        runs (a terminal sliding in, the slider, a notice
                                        coming) — or fails naming what still moves
    scripts/tvty-ctl park               the pointer put outside the window (no hover, no tooltip
                                        left), once tvty has drawn again
    scripts/tvty-ctl paste-image FILE   FILE put in the test compositor's clipboard, then Ctrl+V
    scripts/tvty-ctl inspector          GPUI's inspector, on or off (debug builds)
    scripts/tvty-ctl bus-reconnect      the bus dropped and connected again
    scripts/tvty-ctl fault KIND         KIND's next subscribing fails once (Tickets…)

Which tvty: `--instance NAME` first (or TVTY_CTL_INSTANCE) names a test
instance, whose file dev/tvty-ctl/NAME.json says its state directory, its
wbox config and where its captures go — `test` (scripts/test-env writes it)
or `readme` (the README's demo). Without one: the tvty of this shell's
XDG_STATE_HOME, in the tests' wbox.

tvty listens only when TVTY_DEBUG_CONTROL is set, as scripts/test-env sets
it: a test tvty, never the user's. The rendez-vous is in tvty's state directory: a Unix socket
(tvty-control.sock), or on Windows the file with a loopback port and its
secret (tvty-control.addr). Only the standard library.
Prints the answer as JSON; exits 1 on an error, 2 on a command misused.
"""
import json
import os
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path


# The test instance asked for (--instance, TVTY_CTL_INSTANCE): its state
# home, its wbox config, its captures' folder.
INSTANCE = {}


def state_dir():
    """tvty's state directory, as tvty-config finds it."""
    if INSTANCE.get("state_home"):
        return Path(INSTANCE["state_home"]) / "tvty"
    if os.environ.get("XDG_STATE_HOME"):
        return Path(os.environ["XDG_STATE_HOME"]) / "tvty"
    if os.name == "nt":
        return Path(os.environ["LOCALAPPDATA"]) / "tvty" / "state"
    return Path.home() / ".local" / "state" / "tvty"


def rendezvous():
    """A Unix socket where there are some; elsewhere the file with the
    control's TCP port and its secret."""
    tcp = os.name == "nt" or not hasattr(socket, "AF_UNIX") or os.environ.get("TVTY_CONTROL_TCP")
    name = "tvty-control.addr" if tcp else "tvty-control.sock"
    return state_dir() / name


def connect():
    """A connection to the control, the secret said when there is one."""
    where = rendezvous()
    if where.suffix == ".sock":
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(40)
        s.connect(str(where))
        return s
    address, secret = where.read_text().split("\n")[:2]
    host, port = address.removeprefix("tcp://").rsplit(":", 1)
    s = socket.create_connection((host, int(port)), timeout=40)
    s.sendall(f"secret {secret.strip()}\n".encode())
    return s


def request(command):
    with connect() as s:
        s.sendall((json.dumps(command) + "\n").encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
    return json.loads(data.decode())


# Each command: the arguments it takes (the last ones in brackets may be
# left out), as its usage line says them.
USAGE = {
    "tree": "[--text] [PREFIX]",
    "query": "[PREFIX]",
    "text": "ID",
    "wait-text": "ID TEXT [MS]",
    "where": "ID",
    "click": "ID",
    "hover": "ID",
    "press": "ID",
    "dblclick": "ID",
    "window": "maximize|restore|size [W H]",
    "hold": "MODS",
    "release": "",
    "selection": "",
    "key": "KEYS",
    "type": "TEXT...",
    "wait": "ID [MS]",
    "state": "",
    "ready": "[MS]",
    "park": "",
    "settle": "[MS]",
    "paste-image": "FILE",
    "shot": "NAME",
    "inspector": "",
    "bus-reconnect": "",
    "fault": "KIND",
}


# The flags a command takes, before its arguments.
FLAGS = {"tree": "[--text]", "shot": "[--region ID[+ID…]] [--margin N] [--no-tips] [--now] [--out FILE]"}
USAGE["tree"] = "[PREFIX]"


class Misused(Exception):
    """A command given the wrong arguments: said as its usage line."""


def usage(cmd):
    return " ".join(word for word in ("usage: tvty-ctl", cmd, FLAGS.get(cmd, ""), USAGE[cmd]) if word)


def by_text(prefix, text):
    """The id of the one element under `prefix` that says `text`."""
    answer = request({"cmd": "query", "id": prefix})
    said = [e["id"] for e in answer.get("ok", {}).get("elements", []) if e.get("text") == text]
    if len(said) == 1:
        return said[0]
    if not said:
        raise Misused(f"tvty-ctl: nothing under {prefix!r} says {text!r}")
    raise Misused(f"tvty-ctl: {len(said)} elements under {prefix!r} say {text!r}: {', '.join(said)}")


def check(cmd, rest):
    """The arguments fit the command's usage, or Misused."""
    if cmd not in USAGE:
        raise Misused(f"tvty-ctl: {cmd}: no such command (tvty-ctl --help lists them)")
    if cmd == "window":
        if not rest or rest[0] not in ("maximize", "restore", "size") or len(rest) != (3 if rest[0] == "size" else 1):
            raise Misused(usage(cmd))
        return
    words = USAGE[cmd].split()
    needed = [w for w in words if not w.startswith("[")]
    most = None if any(w.endswith("...") for w in words) else len(words)
    if len(rest) < len(needed) or (most is not None and len(rest) > most):
        raise Misused(usage(cmd))


def number(cmd, text):
    try:
        return int(text)
    except ValueError:
        raise Misused(f"{usage(cmd)}  ({text!r} is not a number of milliseconds)") from None


def unreachable(error):
    """Why the control does not answer, in words."""
    where = rendezvous()
    if isinstance(error, FileNotFoundError):
        why = "no test tvty runs here, or it has not opened its control yet"
    elif isinstance(error, ConnectionRefusedError):
        why = "nothing listens there: tvty is starting, or it is gone"
    else:
        why = str(error)
    return f"tvty-ctl: {where}: {why} (`tvty-ctl ready` waits for it; a test tvty has TVTY_DEBUG_CONTROL, as scripts/test-env sets it)"


def ready(ms):
    """Waits until the control answers."""
    until = time.monotonic() + ms / 1000
    while True:
        try:
            request({"cmd": "state"})
            return {"ok": {"ready": True}}
        except (OSError, ValueError) as error:
            if time.monotonic() >= until:
                raise TimeoutError(f"{unreachable(error)} — still so after {ms} ms") from None
            time.sleep(0.2)


IMAGE_TYPES = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp"}


def paste_image(file):
    """FILE in the clipboard of the compositor the test tvty draws on, then
    Ctrl+V to tvty. Never the desktop's clipboard."""
    path = Path(file)
    kind = IMAGE_TYPES.get(path.suffix.lower())
    if kind is None:
        raise Misused(f"{usage('paste-image')}  ({path.suffix or file!r}: not an image tvty-ctl knows: {', '.join(sorted(IMAGE_TYPES))})")
    if not path.is_file():
        raise Misused(f"{usage('paste-image')}  ({file}: no such file)")
    if not shutil.which("wl-copy"):
        return {"error": "paste-image needs wl-copy (wl-clipboard), on a Wayland test compositor"}
    state = request({"cmd": "state"})
    display = state.get("ok", {}).get("wayland_display")
    if not display:
        return {"error": "the test tvty does not say which Wayland display it draws on"}
    if display == os.environ.get("WAYLAND_DISPLAY"):
        return {"error": f"the test tvty draws on {display}, this shell's own display: that clipboard is the desktop's, left alone"}
    with path.open("rb") as image:
        subprocess.run(["wl-copy", "--type", kind], stdin=image, env={**os.environ, "WAYLAND_DISPLAY": display}, check=True, timeout=10)
    answer = request({"cmd": "key", "keys": "ctrl-v"})
    if "ok" in answer:
        answer["ok"] = {"pasted": str(path), "type": kind, "display": display, **answer["ok"]}
    return answer


REPO = Path(__file__).resolve().parent.parent
WBOX_CONFIG = REPO / "dev" / "tvty-wbox" / "config.yaml"
# Around a region, so that its edge shows.
REGION_MARGIN = 8


def wbox_python():
    """wbox's own interpreter (it lives in its own venv), as the Makefile finds it."""
    if os.environ.get("WBOX_PYTHON"):
        return os.environ["WBOX_PYTHON"]
    launcher = shutil.which("wbox-mcp")
    if launcher:
        first = Path(launcher).read_text(errors="replace").splitlines()[0]
        if first.startswith("#!"):
            return first[2:].strip()
    return None


def instance_file(name):
    return REPO / "dev" / "tvty-ctl" / f"{name}.json"


def shot(name, regions, no_tips, margin, out, now=False):
    """A capture of the instance's compositor once tvty has drawn again."""
    python = wbox_python()
    if python is None:
        return {"error": "shot needs wbox (wbox-mcp on the PATH, or WBOX_PYTHON)"}
    config = Path(INSTANCE.get("wbox_config") or WBOX_CONFIG)
    folder = Path(INSTANCE.get("screenshots") or REPO / "dev" / "tvty-wbox" / "screenshots")
    boxes = []
    for region in regions:
        found = [e for e in request({"cmd": "query", "id": region}).get("ok", {}).get("elements", []) if e["id"] == region]
        if not found:
            return {"error": f"{region}: not on screen"}
        boxes.append(found[-1])
    # Once nothing moves any more — or at once, asked so.
    frame = request({"cmd": "frame" if now else "settle", "park": no_tips})
    if "error" in frame:
        return frame
    began = time.time()
    taken = subprocess.run([python, str(REPO / "scripts" / "wbox_ctl.py"), "shot", str(config), "--name", name], cwd=REPO, capture_output=True, text=True, timeout=30)
    path = folder / f"{name}.png"
    if taken.returncode or not path.is_file():
        return {"error": f"wbox took no capture: {(taken.stderr or taken.stdout).strip()[-300:]}"}
    # The file is this capture's, not one of the same name left from before.
    if path.stat().st_mtime < began - 1:
        return {"error": f"{path}: older than this capture — wbox did not write it"}
    answer = {"path": str(path)}
    if boxes:
        cropper = shutil.which("magick") or shutil.which("convert")
        if cropper is None:
            return {"error": "shot --region needs ImageMagick (magick) to crop"}
        # The box around them all, the margin more.
        left = max(0, int(min(b["x"] for b in boxes)) - margin)
        top = max(0, int(min(b["y"] for b in boxes)) - margin)
        right = int(max(b["x"] + b["w"] for b in boxes)) + margin
        bottom = int(max(b["y"] + b["h"] for b in boxes)) + margin
        subprocess.run([cropper, str(path), "-crop", f"{right - left}x{bottom - top}+{left}+{top}", "+repage", str(path)], check=True, timeout=30)
        answer["region"] = {"ids": regions, "x": left, "y": top, "w": right - left, "h": bottom - top}
    if out:
        Path(out).parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(path, out)
        answer["out"] = str(out)
    return {"ok": answer}


def run(cmd, rest):
    """The command carried out: tvty's answer."""
    command = {"cmd": cmd}
    if cmd in ("tree", "query"):
        command = {"cmd": "query", "id": rest[0] if rest else ""}
    elif cmd == "wait-text":
        command["id"], command["text"] = rest[0], rest[1]
        if len(rest) > 2:
            command["ms"] = number(cmd, rest[2])
    elif cmd in ("where", "click", "dblclick", "hover", "press", "text"):
        command["id"] = rest[0]
    elif cmd == "window":
        command["what"] = rest[0]
        if rest[0] == "size":
            command["w"], command["h"] = number(cmd, rest[1]), number(cmd, rest[2])
    elif cmd == "hold":
        command["keys"] = rest[0]
    elif cmd == "release":
        command = {"cmd": "hold", "keys": ""}
    elif cmd == "key":
        command["keys"] = rest[0]
    elif cmd == "type":
        command["text"] = " ".join(rest)
    elif cmd == "fault":
        command["subscribe"] = rest[0]
    elif cmd == "wait":
        command["id"] = rest[0]
        if len(rest) > 1:
            command["ms"] = number(cmd, rest[1])
    elif cmd == "park":
        return request({"cmd": "frame", "park": True})
    elif cmd == "settle":
        command["ms"] = number(cmd, rest[0]) if rest else 5000
    elif cmd == "ready":
        return ready(number(cmd, rest[0]) if rest else 20000)
    elif cmd == "paste-image":
        return paste_image(rest[0])
    elif cmd == "shot":
        return shot(rest[0], run.regions, run.no_tips, run.margin, run.out, run.now)
    return request(command)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    # Which tvty, before the command.
    name = os.environ.get("TVTY_CTL_INSTANCE")
    if argv[0] == "--instance":
        if len(argv) < 3:
            print("usage: tvty-ctl --instance NAME COMMAND …", file=sys.stderr)
            return 2
        name, argv = argv[1], argv[2:]
    if name:
        try:
            INSTANCE.update(json.loads(instance_file(name).read_text()))
        except (OSError, ValueError) as error:
            print(f"tvty-ctl: instance {name}: {error} (its file: {instance_file(name)})", file=sys.stderr)
            return 2
    cmd, rest = argv[0], argv[1:]
    texts = cmd == "tree" and "--text" in rest
    if cmd == "tree":
        rest = [r for r in rest if r != "--text"]
    # shot's flags, wherever they stand.
    run.no_tips = cmd == "shot" and "--no-tips" in rest
    run.now = cmd == "shot" and "--now" in rest
    run.regions, run.margin, run.out = [], REGION_MARGIN, None
    if cmd == "shot":
        rest = [r for r in rest if r not in ("--no-tips", "--now")]
        for flag in ("--region", "--margin", "--out"):
            if flag not in rest:
                continue
            at = rest.index(flag)
            if at + 1 >= len(rest):
                print(usage(cmd), file=sys.stderr)
                return 2
            value = rest[at + 1]
            del rest[at:at + 2]
            if flag == "--region":
                run.regions = [r for r in value.split("+") if r]
            elif flag == "--out":
                run.out = value
            elif value.isdigit():
                run.margin = int(value)
            else:
                print(f"{usage(cmd)}  ({value!r} is not a margin in pixels)", file=sys.stderr)
                return 2
    try:
        # An element named by what it says, in place of its id.
        if "--text" in rest and cmd in ("click", "dblclick", "hover", "press", "where", "wait"):
            at = rest.index("--text")
            if at + 2 >= len(rest) + 0 and len(rest) < at + 3:
                raise Misused(f"usage: tvty-ctl {cmd} --text PREFIX TEXT")
            rest[at:at + 3] = [by_text(rest[at + 1], rest[at + 2])]
        check(cmd, rest)
        answer = run(cmd, rest)
    except Misused as error:
        print(error, file=sys.stderr)
        return 2
    except TimeoutError as error:
        print(error, file=sys.stderr)
        return 1
    except OSError as error:
        print(unreachable(error), file=sys.stderr)
        return 1
    if texts and "ok" in answer:
        for element in answer["ok"]["elements"]:
            if "text" in element:
                print(f"{element['id']}\t{element['text']}")
        return 0
    print(json.dumps(answer.get("ok", answer), indent=1))
    return 1 if "error" in answer else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
