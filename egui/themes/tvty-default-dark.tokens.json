{
  "$description": "tvty's window in the kit's Default Dark: the colours gpui-component gives tvty, measured on its screenshots",
  "$extends": "pop-dark",
  "surface": {
    "$type": "color",
    "canvas": {
      "$value": "#0a0a0a",
      "$description": "The window, the panels, the sidebar."
    },
    "panel": {
      "$value": "#0a0a0a"
    },
    "sunken": {
      "$value": "#0a0a0a"
    },
    "raised": {
      "$value": "#151515",
      "$description": "A field at rest."
    },
    "overlay": {
      "$value": "#0a0a0a"
    }
  },
  "text": {
    "$type": "color",
    "default": {
      "$value": "#fafafa"
    },
    "strong": {
      "$value": "#fafafa"
    },
    "muted": {
      "$value": "#a3a3a3"
    }
  },
  "border": {
    "$type": "color",
    "default": {
      "$value": "#262626"
    }
  },
  "accent": {
    "$type": "color",
    "default": {
      "$value": "#60a5fa",
      "$description": "The theme's blue: tvty's accent."
    }
  },
  "title-bar": {
    "$description": "tvty's title bar: the title at the start, muted, a line under the bar.",
    "height": {
      "$type": "dimension",
      "$value": {
        "value": 41,
        "unit": "px"
      }
    },
    "align": {
      "$type": "string",
      "$value": "start"
    },
    "rest": {
      "fill": {
        "$type": "color",
        "$value": "#141414"
      },
      "text": {
        "$type": "color",
        "$value": "{text.muted}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{border.default}"
      },
      "border-width": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "px"
        }
      }
    }
  },
  "window-button": {
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 34,
        "unit": "px"
      }
    }
  },
  "window-close": {
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 34,
        "unit": "px"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "ui": {
        "$value": [
          "Inter",
          "sans-serif"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "small": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "body": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "heading": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      }
    }
  },
  "tvty": {
    "$description": "tvty's own tokens, read by path.",
    "text": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "sm": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "base": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 18,
          "unit": "px"
        }
      }
    }
  },
  "area-strip": {
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 15,
        "unit": "px"
      }
    },
    "rest": {
      "fill": {
        "$type": "color",
        "$value": "{surface.canvas}"
      },
      "text": {
        "$type": "color",
        "$value": "#474747"
      }
    }
  },
  "area-grip": {
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "height": {
      "$type": "dimension",
      "$value": {
        "value": 44,
        "unit": "px"
      }
    },
    "rest": {
      "fill": {
        "$type": "color",
        "$value": "{border.default}"
      },
      "radius": {
        "$type": "dimension",
        "$value": {
          "value": 3,
          "unit": "px"
        }
      }
    },
    "offset": {
      "$type": "dimension",
      "$value": {
        "value": 4.5,
        "unit": "px"
      }
    }
  },
  "side-area": {
    "rest": {
      "border-width": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}
