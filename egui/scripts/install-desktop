#!/bin/sh
# "tvty-egui Dev" in the desktop's launcher: ~/.local/bin/tvty-egui runs
# this checkout's debug build. tvty's own icon (make install-desktop).
set -eu
here="$(cd "$(dirname "$0")/.." && pwd)"
data="${XDG_DATA_HOME:-$HOME/.local/share}"
bin="$HOME/.local/bin"
mkdir -p "$data/applications" "$bin"
sed -e "s|@BIN@|${CARGO_TARGET_DIR:-$here/target}/debug/tvty-egui|" \
    -e "s|@SCENE@|$here/../dev/scene.json|" \
    "$here/packaging/tvty-egui-launch" >"$bin/tvty-egui"
chmod 755 "$bin/tvty-egui"
sed "s|@EXEC@|$bin/tvty-egui|" "$here/packaging/tvty-egui.desktop" \
    >"$data/applications/tvty-egui.desktop"
update-desktop-database -q "$data/applications" 2>/dev/null || true
echo "tvty-egui Dev installed: $bin/tvty-egui"
